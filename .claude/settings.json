{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "name": "Auto-fix on edit（按 stack.json 路由各服务 lint_fix）",
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-lint.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "name": "交付前 lint/format 兜底（按 stack.json 路由全量检查）",
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-gate.sh\""
          }
        ]
      }
    ]
  }
}
